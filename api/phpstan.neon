includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    parseModelCastsMethod: true
    ignoreErrors:
        - identifier: missingType.generics
        - identifier: missingType.iterableValue
        -
            rawMessage: 'Parameter #1 $rules of method App\Shared\OpenApi\RequestRulesExtractor::makeParameters() expects array<string, Dedoc\Scramble\Support\OperationExtensions\RulesExtractor\RuleSet>, array given.'
            identifier: argument.type
            path: app/Shared/OpenApi/RequestRulesExtractor.php
